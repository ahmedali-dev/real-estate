# MongoDB connection string.
# Replace <db_password> with your actual database user password.
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers.
MONGODB_URI=mongodb+srv://41forrealestat_db_user:<db_password>@cluster0.uoihwgh.mongodb.net/realestate?appName=Cluster0

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string
# Base URL of this app. Update to your production URL when deploying.
NEXTAUTH_URL=http://localhost:3000

# Cloudinary (image uploads).
# Find this under your Cloudinary dashboard -> API Keys -> "API Environment variable".
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Keep this out of version control — treat it like a password.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
